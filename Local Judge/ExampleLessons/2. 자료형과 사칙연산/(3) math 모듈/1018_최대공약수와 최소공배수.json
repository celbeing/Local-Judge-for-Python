  "description": "\uD30C\uC774\uC36C\uC758 \u0060math\u0060\uBAA8\uB4C8\uC5D0\uB294 \uB2E4\uC591\uD55C \uACC4\uC0B0\uC744 \uC9C0\uC6D0\uD558\uB294 \uD568\uC218\uAC00 \uD3EC\uD568\uB418\uC5B4\uC788\uB2E4.\r\n\u0060math\u0060\uBAA8\uB4C8\uC744 \uC0AC\uC6A9\uD558\uB824\uBA74 \u0060import\u0060 \uD0A4\uC6CC\uB4DC\uB85C \u0060math\u0060\uBAA8\uB4C8\uC744 \uBD88\uB7EC\uC624\uBA74 \uB41C\uB2E4.\r\n\r\n\u0060\u0060\u0060\r\nimport math\r\na = math.gcd(10, 12)\r\nb = math.lcm(14, 35)\r\n\u0060\u0060\u0060\r\n\r\n\uB450 \uC790\uC5F0\uC218 $A$\uC640 $B$\uAC00 \uC8FC\uC5B4\uC84C\uC744 \uB54C \uB450 \uC218\uC758 \uCD5C\uB300\uACF5\uC57D\uC218\uC640 \uCD5C\uC18C\uACF5\uBC30\uC218\uB97C \uAC01\uAC01 \uAD6C\uD574\uBCF4\uC790.",
  "inputFormat": "\uCCAB \uBC88\uC9F8 \uC904\uC5D0 \uC790\uC5F0\uC218 $A$\uAC00 \uC8FC\uC5B4\uC9C4\uB2E4.\r\n\uB450 \uBC88\uC9F8 \uC904\uC5D0 \uC790\uC5F0\uC218 $B$\uAC00 \uC8FC\uC5B4\uC9C4\uB2E4.",
  "outputFormat": "\uCCAB \uBC88\uC9F8 \uC904\uC5D0 $A$\uC640 $B$\uC758 \uCD5C\uB300\uACF5\uC57D\uC218\uB97C \uCD9C\uB825\uD55C\uB2E4.\r\n\uB450 \uBC88\uC9F8 \uC904\uC5D0 $A$\uC640 $B$\uC758 \uCD5C\uC18C\uACF5\uBC30\uC218\uB97C \uCD9C\uB825\uD55C\uB2E4.",
